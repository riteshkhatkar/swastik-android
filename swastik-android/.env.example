# ==============================================================================
# Swastik Hospital & Research Centre - Android App Environment Template (.env.example)
# Location: swastik-android/.env.example
# Copy this file to swastik-android/.env and fill in your credentials
# ==============================================================================

# 1. Backend REST API Base URL
# Position: swastik-android/services/api.ts -> API_BASE_URL
EXPO_PUBLIC_API_URL=https://swastik.orelse.ai

# 2. Razorpay Payment Gateway Key ID (Public Key)
# Position: swastik-android/components/RazorpayModal.tsx -> RAZORPAY_KEY_ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# 3. Google OAuth 2.0 Client ID (Android / Web OAuth)
# Position: swastik-android/components/GoogleSignInModal.tsx -> GOOGLE_CLIENT_ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 4. WhatsApp Support Helpline Number
# Position: swastik-android/components/WhatsAppFloat.tsx -> hospitalPhone
EXPO_PUBLIC_WHATSAPP_NUMBER=+919876543210
