# Backend API URL (default: http://localhost:8000)
REACT_APP_API_URL=https://swastik.orelse.ai

# WhatsApp number for floating button and contact form (country code + number, no + or spaces). e.g. 917559316330
REACT_APP_WHATSAPP_NUMBER=917559316330

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

